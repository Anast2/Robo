<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>plantroid_social</name>
  <version>1.0.0</version>
  <description>Package responsible for managing the social interfaces of plantroid, reciving data from the listen server, using the chatbot and GPTJ interfaces and prosody generation packages to genrate responses.</description>
  <maintainer email="antonio@mizuuchi.lab.tuat.ac.jp">Antonio Galiza Cerdeira Gonzalez</maintainer>
  <license>Apache License 2.0</license>

  <depend>rclpy</depend>
  <depend>speech_recogntion</depend>
  <depend>uuid</depend>
  <depend>plantroid_encoder</depend>
  <depend>plantroid_gestures</depend>
  <depend>plantroid_gui</depend>
  <depend>plantroid_listener</depend>
  <depend>plantroid_vision</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
