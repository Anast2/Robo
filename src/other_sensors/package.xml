<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>plantroid_sensors</name>
  <version>1.0.0</version>
  <description>Package related to Plantroid sensors that are not vision related. It interfaces with the Arduino Nano inside the smart PlantPot and the NPK+EC+pH integrated soil sensor.</description>
  <maintainer email="antonio@mizuuchi.lab.tuat.ac.jp">plantroid</maintainer>
  <license>Apache License 2.0</license>

  <depend>rclpy</depend>
  <depend>plantroid_msgs</depend>
  <depend>syslog</depend>
  <depend>serial</depend>
  <depend>pymodbus</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
