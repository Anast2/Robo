<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>plantroid_navigation</name>
  <version>1.0.0</version>
  <description>Package that implementes the end-to-end VGG16-based navigation, which follows sunlight/shadow while safely avoiding obstacles.</description>
  <maintainer email="antonio@mizuuchi.lab.tuat.ac.jp">Antonio Galiza Cerdeira Gonzalez</maintainer>
  <license>Apache License 2.0</license>


  <depend>plantroid_msgs</depend>
  <depend>plantroid_encoder</depend>
  <depend>plantroid_vision</depend>
  <depend>plantroid_busy</depend>
  <depend>tensorflow</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  


  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
